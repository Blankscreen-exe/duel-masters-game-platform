# Settings for docker compose: copy to .env next to docker-compose.yml and adjust.
# Settings left commented out keep the default shown. DOMAIN and APP_SECRET_KEY are the ones to set.

# The site's address, without https://. Point its DNS (an A or AAAA record) at this server and keep
# ports 80 and 443 open: Caddy then gets and renews the HTTPS certificate on its own.
#   localhost   to try it on this computer, at https://localhost (Caddy's own certificate, so the
#               browser warns once)
#   :80         plain HTTP, behind a tunnel or proxy that adds HTTPS itself (such as a Cloudflare
#               tunnel pointed at http://localhost:80); set SITE_ORIGINS to its address then
DOMAIN=localhost

# The ports Caddy is published on. Certificates for a real domain need the defaults.
# HTTP_PORT=80
# HTTPS_PORT=443

# debug | info | warn | error
# LOG_LEVEL=info
# text | json (json by default in the container)
# LOG_FORMAT=json

# The addresses players open the site from, comma-separated. Live connections (the lobby, chat and
# games) from any other page are refused. Defaults to https://<DOMAIN>, so it only needs setting for
# other addresses, such as a tunnel's. A host starting with *. stands for any one subdomain, for
# tunnels whose address changes every run, e.g. SITE_ORIGINS=https://*.trycloudflare.com
# SITE_ORIGINS=https://duelmasters.example

# The login cookie is HTTPS-only in production. Set to false only when players reach the server
# over plain HTTP (e.g. DOMAIN=:80 opened as http://192.168.1.20 on a home network). Tunnels and
# proxies with HTTPS need nothing.
# SECURE_COOKIES=true

# Required: encrypts the mail server's password and settings in the database. Make one with
#   openssl rand -base64 32
# Keep it out of the database and its backups. If it is lost, only the mail settings are: enter them
# again in the admin panel.
APP_SECRET_KEY=

# Where Claude Code reaches the tools it plays with, on this computer alone (docs/claude-opponent.md).
# Unset in production, so not served. Inside a container, this cannot be reached from outside it.
# LOCAL_PLAYER_ADDR=127.0.0.1:8081

# Database: sqlite (a file on the data volume, nothing to install) or postgres.
# DB_DRIVER=sqlite

# With DB_DRIVER=postgres. Start the bundled PostgreSQL with
# `docker compose --profile postgres up -d`, where it is reachable as "postgres",
# and use the same user, password and database here and in POSTGRES_URL.
# POSTGRES_USER=platform
# POSTGRES_PASSWORD=change-me-to-a-long-random-secret
# POSTGRES_DB=platform
# POSTGRES_URL=postgres://platform:change-me-to-a-long-random-secret@postgres:5432/platform?sslmode=disable
