{
  "name": "@duel-masters/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "board": "pnpm --filter @duel-masters/duel-board build",
    "predev": "pnpm run board",
    "dev": "next dev --port 3000",
    "prebuild": "pnpm run board",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "pretypecheck": "pnpm run board",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript ../../api/openapi.yaml --output src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "@duel-masters/duel-board": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
