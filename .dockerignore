# Images only receive what they build from; everything else stays out of the
# build context.
*

# The Go server (apps/server/Dockerfile) and the card database it serves.
!apps/server/
!resources/duelmasters_db/data/cards.json
!resources/duelmasters_db/data/images/
!resources/duelmasters_db/data/icons/sets/

# The website (apps/web/Dockerfile) and the workspace it is installed from.
!apps/web/
!packages/
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml

# Built, installed or local files inside those folders.
apps/server/**/data/
**/node_modules/
**/.next/
**/dist/
**/*.tsbuildinfo
**/next-env.d.ts
**/.env
**/.env.*
